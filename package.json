{
  "name": "laravel-sqlite-viewer",
  "displayName": "Laravel SQLite Viewer",
  "description": "Explore Laravel SQLite databases directly inside VS Code.",
  "version": "0.1.1",
  "publisher": "IvanMercedes",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanmercedes/laravel-sqlite-viewer.git"
  },
  "activationEvents": [
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "icon": "./assets/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "laravel-sqlite-viewer.openDatabase",
        "title": "Open SQLite Database",
        "category": "SQLite"
      },
      {
        "command": "laravel-sqlite-viewer.toggleEditMode",
        "title": "Toggle Edit Mode",
        "category": "SQLite"
      },
      {
        "command": "laravel-sqlite-viewer.runQuery",
        "title": "Run SQL Query",
        "category": "SQLite"
      },
      {
        "command": "laravel-sqlite-viewer.findDatabases",
        "title": "Find SQLite Databases",
        "category": "SQLite"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(sqlite|db|sqlite3)$/",
          "command": "laravel-sqlite-viewer.openDatabase",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  }
}
